{
  "args": ["https://moonvy.com/project/<PROJECT_ID>/<DIR_ID>/<FILE_ID>", "--node", "<NODE_ID>"],
  "expect": {
    "rowCount": { "min": 1, "max": 1 },
    "columns": ["id", "name", "bboxX", "bboxY", "bboxW", "bboxH", "background", "color", "fontSize", "fontWeight", "borderRadius", "opacity"],
    "types": {
      "id": "string",
      "name": "string",
      "bboxX": "number",
      "bboxY": "number",
      "bboxW": "number",
      "bboxH": "number",
      "background": "string|null",
      "color": "string|null",
      "fontSize": "number|null",
      "fontWeight": "number|string|null",
      "borderRadius": "number|null",
      "opacity": "number|null"
    },
    "notEmpty": ["id"]
  }
}
