{
  "args": [
    "https://moonvy.com/project/<PROJECT_ID>/<DIR_ID>/<FILE_ID>",
    "--node",
    "<NODE_ID>"
  ],
  "expect": {
    "rowCount": {
      "min": 1,
      "max": 1
    },
    "columns": [
      "id",
      "name",
      "type",
      "bboxX",
      "bboxY",
      "bboxW",
      "bboxH",
      "text",
      "background",
      "border",
      "borderRadius",
      "opacity",
      "visible",
      "color",
      "fontFamily",
      "fontWeight",
      "fontSize",
      "lineHeight"
    ],
    "types": {
      "id": "string",
      "name": "string",
      "bboxX": "number",
      "bboxY": "number",
      "bboxW": "number",
      "bboxH": "number",
      "background": "string|null",
      "color": "string|null",
      "fontSize": "number|null",
      "fontWeight": "number|null",
      "borderRadius": "number|null",
      "opacity": "number|null",
      "type": "string",
      "text": "string|null",
      "border": "string|null",
      "visible": "boolean",
      "fontFamily": "string|null",
      "lineHeight": "number|null"
    },
    "notEmpty": [
      "id"
    ]
  }
}
